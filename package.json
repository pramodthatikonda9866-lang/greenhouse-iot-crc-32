{
  "name": "smart-greenhouse-iot-crc32-monitor",
  "version": "1.0.0",
  "description": "Smart Greenhouse IoT Packet Reliability Monitor with Deterministic CRC-32 Engine",
  "main": "server/src/server.js",
  "scripts": {
    "start": "node server/src/server.js",
    "build": "npm --prefix client run build",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server:dev\" \"npm run client\"",
    "test": "npm --prefix server test",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "keywords": ["iot", "crc32", "reliability", "greenhouse", "react", "nodejs", "socket.io"],
  "author": "Antigravity",
  "license": "MIT"
}
